{
  "name": "OBRA-GIS",
  "short_name": "OBRA-GIS",
  "description": "Visor de KML/KMZ sobre ortofoto con anotaciones, fotos, vídeos y notas de voz georreferenciadas.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e1a15",
  "theme_color": "#0b3d2e",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{
        "name": "files",
        "accept": [".kml", ".kmz", "application/vnd.google-earth.kml+xml", "application/vnd.google-earth.kmz", "application/xml", "text/xml", "text/plain", "application/octet-stream", "application/zip", "*/*"]
      }]
    }
  },
  "file_handlers": [{
    "action": "./",
    "accept": {
      "application/vnd.google-earth.kml+xml": [".kml"],
      "application/vnd.google-earth.kmz": [".kmz"]
    }
  }]
}
